%  STEP VISIBILITY SYSTEM
% ═══════════════════════════════════════════════════════════════════════════════

\RequirePackage{xkeyval}
\RequirePackage{xstring}
\RequirePackage{etoolbox}
\RequirePackage{trimspaces}
\RequirePackage{ifthen}

% ═══════════════════════════════════════════════════════════════════════════════
%  STEP VISIBILITY SYSTEM — set-based
%
%  \showmytikz[1,2,3]{file.tex}       show exactly steps 1, 2, 3
%  \showmytikz[2,3,6]{file.tex}       show exactly steps 2, 3, 6
%  \showmytikz[]{file.tex}            show nothing (empty set)
%
%  Inside diagram files:
%  \ifstep{N}{content}                show content if N is in the active set
%
%  Word aliases still accepted for single steps: eins=1, zwei=2, etc.
%  (Useful for a quick \showmytikz[eins]{...} shorthand.)
% ═══════════════════════════════════════════════════════════════════════════════

% ── Active step set: stored as ,1,2,3, (with surrounding commas for matching) ─
\def\@stepset{,,}%  default: empty set

% ── Word → number: resolves a single token to its digit string ────────────────
% Used only for single-word shorthands. Returns the digit in \@ts@num.
\newcommand{\@resolveword}[1]{%
  \IfStrEqCase{#1}{%
    {null}{\def\@ts@num{}}%
    {eins}{\def\@ts@num{1}}%
    {zwei}{\def\@ts@num{2}}%
    {drei}{\def\@ts@num{3}}%
    {vier}{\def\@ts@num{4}}%
    {fuenf}{\def\@ts@num{5}}%
    {sechs}{\def\@ts@num{6}}%
    {sieben}{\def\@ts@num{7}}%
    {acht}{\def\@ts@num{8}}%
    {neun}{\def\@ts@num{9}}%
    {zehn}{\def\@ts@num{10}}%
    {one}{\def\@ts@num{1}}%
    {two}{\def\@ts@num{2}}%
    {three}{\def\@ts@num{3}}%
    {four}{\def\@ts@num{4}}%
    {five}{\def\@ts@num{5}}%
    {six}{\def\@ts@num{6}}%
    {seven}{\def\@ts@num{7}}%
    {eight}{\def\@ts@num{8}}%
    {nine}{\def\@ts@num{9}}%
    {ten}{\def\@ts@num{10}}%
  }[\def\@ts@num{#1}]% fallback: already a number
}

% ── Build \@stepset from a comma-separated list (words or numbers) ────────────
\newcommand{\@buildstepset}[1]{%
  \gdef\@stepset{,}%
  \forcsvlist{\@addtostepset}{#1}%
}
\newcommand{\@addtostepset}[1]{%
  \def\@trimmed{#1}%
  \trim@spaces@in\@trimmed
  \@resolveword{\@trimmed}%
  \ifx\@ts@num\empty\else
    \expandafter\xdef\expandafter\@stepset\expandafter{\@stepset\@ts@num,}%
  \fi
}

% ── \ifstep{N}{content} — show content if N is in the active set ─────────────
% Uses \IfSubStr from xstring (already loaded). No @ internals at point of use.
\newcommand{\ifstep}[2]{%
  \IfSubStr{\@stepset}{,#1,}{#2}{}%
}

% ── Keys for \showmytikz ──────────────────────────────────────────────────────
\define@key{showmytikz}{step}{\def\@ts@step{#1}}
\define@key{showmytikz}{caption}{\def\@ts@caption{#1}}
\define@key{showmytikz}{label}{\def\@ts@label{#1}}

% ── \showmytikz[1,2,3]{file.tex}  or  \showmytikz[step=drei]{file.tex} ────────
\newcommand{\showmytikz}[2][]{%
  \begingroup
  \def\@ts@step{}%
  \def\@ts@caption{}%
  \def\@ts@label{}%
  % Save the current stepset so nested calls don't clobber it
  \let\@stepset@saved\@stepset
  % Parse arguments and build new stepset
  \IfSubStr{#1}{=}{%
    \setkeys{showmytikz}{#1}%
    \@buildstepset{\@ts@step}%
  }{%
    \@buildstepset{#1}%
  }%
  \if@hsbbeamer
    \@hsb@tikz@beamer{#2}%
  \else
    \@hsb@tikz@article{#2}%
  \fi
  % Restore the previous stepset (xdef made it global, so restore globally too)
  \global\let\@stepset\@stepset@saved
  \endgroup
}

% ── Beamer: fit into slide ────────────────────────────────────────────────────
% \begingroup scopes coordinate \def's; resetting \tikz@intersect@namedpaths
% clears the named-path registry so path names don't leak between diagrams.
\newcommand{\@hsb@tikz@beamer}[1]{%
  \begin{adjustbox}{max width=200pt, max totalheight=0.8\textheight}%
    \IfFileExists{#1}{\input{#1}}{{\color{red}FILE NOT FOUND: #1}}%
  \end{adjustbox}%
}

% ── Article: wrap in figure with auto caption/label ──────────────────────────
\newcommand{\@hsb@tikz@article}[1]{%
  \IfFileExists{#1}{%
    \let\myoldfighandle\myfighandle
    \global\let\myfighandle\mysechandle
    \ifthenelse{\equal{\myoldfighandle}{\myfighandle}}{%
      \stepcounter{mysubfigure}%
    }{%
      \setcounter{mysubfigure}{0}%
    }%
      \ifdefempty{\@ts@caption}{%
        \textbf{Fig.~\ref{fig:\myfighandle\themysubfigure}}%
      }{%
        \ifdefempty{\@ts@label}{}{\textbf{Fig.~\ref{\@ts@label}}}%
      }%    
    \begin{figure}[ht!]%
      \centering%
          \begin{adjustbox}{max width=\linewidth}%
            \IfFileExists{#1}{\input{#1}}{{\color{red}FILE NOT FOUND: #1}}%
          \end{adjustbox}%
      \ifdefempty{\@ts@caption}{%
        \caption{\mysechandle~\themysubfigure}%
        \label{fig:\myfighandle\themysubfigure}%
      }{%
        \caption{\@ts@caption}%
        \ifdefempty{\@ts@label}{}{\label{\@ts@label}}%
      }%
    \end{figure}%
  }{{\color{red}FILE NOT FOUND: #1}}%
}

% ── \showmybitmap[url]{file} ──────────────────────────────────────────────────
\newcommand{\showmybitmap}[2][]{%
  \IfFileExists{#2}{%
    \if@hsbbeamer
      \href{#1}{\adjustimage{max size={200pt}{150pt}}{#2}}%
    \else
      \let\myoldfighandle\myfighandle
      \global\let\myfighandle\mysechandle
      \ifthenelse{\equal{\myoldfighandle}{\myfighandle}}{%
        \stepcounter{mysubfigure}%
      }{%
        \setcounter{mysubfigure}{0}%
      }%
      \begin{figure}[ht!]%
        \centering%
        \adjustimage{max size={200pt}{150pt}}{#2}%
        \caption{\mysechandle~\themysubfigure}\label{fig:\mysechandle\themysubfigure}%
      \end{figure}%
    \fi
  }{\color{red}FILE NOT FOUND: #2}%
}

% ── \mytable ──────────────────────────────────────────────────────────────────
\newcommand{\mytable}[2][]{%
  \if@hsbbeamer
    #2%
  \else
    % \textbf{Tab.~\ref{tab:\mytabhandle~\themysubtab}}
    \begin{table}[ht!]%
      \let\myoldtabhandle\mytabhandle
      \global\let\mytabhandle\mysechandle
      \ifthenelse{\equal{\myoldtabhandle}{\mytabhandle}}{%
        \stepcounter{mysubtab}%
      }{%
        \setcounter{mysubtab}{0}%
      }%
      \centering%
      #2%
      \caption{\mysechandle~\themysubtab}\label{tab:\mytabhandle~\themysubtab}%
    \end{table}%
  \fi
}

% ── Text helpers ──────────────────────────────────────────────────────────────
\newcommand{\mycomment}[2][]{%
  \if@hsbbeamer
    \begin{textblock*}{120pt}(230pt,50pt)\tiny #2\end{textblock*}%
  \else
    #2\par%
  \fi
}

\newcommand{\mytext}[2][]{%
  \if@hsbbeamer
    \begin{textblock*}{200pt}(20pt,50pt){\footnotesize #2}\end{textblock*}%
  \else
    #2%
  \fi
}

\newcommand{\mylonglist}[2][]{%
  \begin{multicols}{2}#2\end{multicols}%
}



% ── \myblock: small coloured progress/fill bar ───────────────────────────────
\newcommand{\myblock}[2][0.1ex]{%
  \begin{tikzpicture}[x=#1, y=1ex]
    \draw[fill=HSBgruen!50] (0,0) rectangle (#2,1);
  \end{tikzpicture}%
}

% ── Article-only handle infrastructure (no-ops in Beamer) ────────────────────
\if@hsbbeamer\else
  \def\myfighandle{}
  \newcounter{mysubfigure}
  \renewcommand{\themysubfigure}{%
    \ifcase\value{mysubfigure}\or(ii)\or(iii)\or(iv)\or(v)\or(vi)\or(vii)\else?\fi%
  }
  \def\myoldfighandle{}

  \def\mytabhandle{}
  \newcounter{mysubtab}
  \renewcommand{\themysubtab}{%
    \ifcase\value{mysubtab}\or(ii)\or(iii)\or(iv)\or(v)\or(vi)\or(vii)\else?\fi%
  }
  \def\myoldtabhandle{}

  \def\mysechandle{}
  \newcounter{mysubsec}
  \renewcommand{\themysubsec}{%
    \ifcase\value{mysubsec}\or(ii)\or(iii)\or(iv)\or(v)\or(vi)\else?\fi%
  }
  \def\myoldsechandle{}

  \renewenvironment{frame}[2][]{%
    \let\myoldsechandle\mysechandle
    \gdef\mysechandle{#2}%
    \ifthenelse{\equal{\myoldsechandle}{\mysechandle}}{%
      \faHandPointRight %%%% new slide but not new secion
    }{%
      \subsection*{#2}% %%%%% slide with different title, hence new section
      \faHandPointRight
    }%
  }{}
\fi