    }
  }[]%
}

% Safe fallback defaults (blau-tuerkis) in case \HSBsetscheme runs
% before xstring is loaded — prevents undefined-colour pink/errors
\definecolor{HSBbgTL}{RGB}{5,16,47}
\definecolor{HSBbgTR}{RGB}{18,138,166}
\definecolor{HSBbgBL}{RGB}{8,84,137}
\definecolor{HSBbgBR}{RGB}{50,182,200}
\definecolor{HSBhlL} {RGB}{3,28,65}
\definecolor{HSBhlR} {RGB}{49,180,200}

% Apply scheme: immediately (for preamble use) and again at document start
\HSBsetscheme
\AtBeginDocument{\HSBsetscheme}

% ── Logo paths ────────────────────────────────────────────────────────────────
% Three files per project, in the project root (no ../shared/logos/ tree, no
% per-organisation folders -- a project carries only its own organisation):
%     HSB_Office-neg.png           white logo for the dark gradient backgrounds
%     HSB_Office-pos.png           coloured logo
%     HSB_Zusatz_Office-neg.png    supplementary ("Zusatz") logo, white
% \HSBorganisation is only the file-name prefix (HSB -> IBB gives IBB_Office-neg.png).
% The macros expand lazily, so \renewcommand after loading the theme works;
% a single path can also be set directly:  \renewcommand{\OfficeLogoPath}{x.png}
\newcommand{\ZusatzLogoPath}{\HSBlogodir\HSBorganisation_Zusatz_Office-neg.png}
\newcommand{\OfficeLogoPath}{\HSBlogodir\HSBorganisation_Office-neg.png}
\newcommand{\OfficeLogoPathColor}{\HSBlogodir\HSBorganisation_Office-pos.png}

% ── Beamer font/colour settings ───────────────────────────────────────────────
\setbeamerfont{title}{size=\Large, series=\bfseries}
\setbeamerfont{subtitle}{size=\large}

\definecolor{HSB-blau}{RGB}{10,85,140}

\setbeamercolor{normal text}      {fg=HSB-blau}
\setbeamercolor{frametitle}       {fg=HSB-blau}
\setbeamerfont{frametitle}        {size=\normalsize}
\setbeamerfont{framesubtitle}     {size=\small}
\setbeamercolor{itemize item}     {fg=HSB-blau}
\setbeamercolor{itemize subitem}  {fg=HSB-blau}
\setbeamercolor{section in toc}   {use=normal text, fg=normal text.fg}
\setbeamercolor{subsection in toc}{use=normal text, fg=normal text.fg}
\setbeamercolor{enumerate item}   {fg=HSB-blau}
\setbeamercolor{enumerate subitem}{fg=HSB-blau}