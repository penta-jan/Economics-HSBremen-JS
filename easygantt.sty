\makeatother
    \NewDocumentCommand{\barmile}{m m m m}{
            % #1 task
            % #2 start
            % #3 duration
            % #4 milestone name
        \renewcommand{\oldend}{\myend}
        \ifdefempty{#2}
           {
            \pgfmathtruncatemacro\oend{\oldend+1}
                \ifdefempty{#3}{
                    \pgfmathtruncatemacro\myend{\dauer}
                }{
                    \pgfmathtruncatemacro\myend{\oldend+#3}
                }
             \ganttbar[name=bar\thetask,bar/.append style={fill=lightgray}]{#1}{\oend}{\myend}\\
             \ganttlink{mile\theoldtask}{bar\thetask}
          }{
                \ifdefempty{#3}{
                    \pgfmathtruncatemacro\myend{\dauer}
                }{
                    \pgfmathtruncatemacro\myend{#2+#3-1}
                }
            \ganttbar[name=bar\thetask,bar/.append style={fill=yellow}]{#1}{#2}{\myend}\\

          }
        \ifdefempty{#4}
        {}{
        \ganttmilestone[name=mile\thetask]{#4}{\myend}\\
        \ganttlink{bar\thetask}{mile\thetask}
        }
    }
\makeatletter

\makeatother
    \NewDocumentCommand{\barmilerule}{m m m}{
            % #1 denominator
            % #2 start
            % #3 duration
       \renewcommand{\oldend}{\myend}
       \ifdefempty{#3}{
           \pgfmathtruncatemacro\myend{\dauer}
           }{
           \ifdefempty{#2}
                {
            \pgfmathtruncatemacro\myend{\oldend+#3}
            \ganttvrule[vrule/.append style={orange, solid, thin}]{\footnotesize{#1}}{\myend}           
                }
                {
            \pgfmathtruncatemacro\myend{#2+#3-1}
            }
        }
        \ganttvrule[vrule/.append style={orange, solid, thin}]{\footnotesize{#1}}{\myend}
    }
\makeatletter


\newcommand{\barmilelink}[2]{
    \ganttlink{mile#1}{bar#2}
}





\NewDocumentCommand\inserttable{m}{
    \DTLloaddb{#1}{#1}
    \DTLforeach{#1}{%
        \task=task,\start=start,\duration=duration,\milestone=milestone}{%
            \setcounter{oldtask}{\thetask}
            \stepcounter{task}
            \barmile{Task \arabic{task}: \task}{\start}{\duration}{\milestone}
        }
     \setcounter{task}{0}
