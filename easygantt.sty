\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{easygantt}[2022/02/04 Easy Gantt]

\RequirePackage{pgfgantt}  
\RequirePackage{datatool}
\RequirePackage{etoolbox} % for ifdefempty
\RequirePackage{environ}

\newcommand{\oldend}{}
\newcommand{\schluss}{}
\newcounter{task}
\newcounter{oldtask}
\newcounter{milestone}


\NewEnviron{meingantt}[1]{
    \def\dauer{#1}
    \pgfmathtruncatemacro\jahre{\dauer}
    \pgfmathtruncatemacro\quartale{\dauer*4}
    \pgfmathtruncatemacro\monate{\dauer*12}
    \def\dauer{\monate}
    \begin{ganttchart}[
        y unit chart=0.5cm, 
        title height=1, 
        y unit title=0.5cm,
        Milenew/.style={milestone/.append style={fill=orange}},
        bar/.append style={fill=lightgray}]
        {1}{\monate}
         \foreach \y in {1,...,\jahre}{
            \gantttitle{Y\y}{12}
            }\\
         \foreach \y in {1,...,\jahre}{
            \foreach \q in {1,...,4}{
                \gantttitle{Q\q}{3}
            }
            }\\
         \foreach \y in {1,...,\jahre}{
            \foreach \m in {1,...,12}{
                \gantttitle{\m}{1}
            }
            }\\          
        \BODY
    \end{ganttchart}
}

