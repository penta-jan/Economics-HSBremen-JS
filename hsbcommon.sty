% ═══════════════════════════════════════════════════════════════════════════════
%  STEP VISIBILITY SYSTEM — set-based
%
%  \showmytikz[1,2,3]{file.tex}       show exactly steps 1, 2, 3
%  \showmytikz[2,3,6]{file.tex}       show exactly steps 2, 3, 6
%  \showmytikz[]{file.tex}            show nothing (empty set)
%
%  Inside diagram files:
%  \ifstep{N}{content}                show content if N is in the active set
%  \ifstep{N1,N2}{content}            show content if N1 OR N2 is in the active set
%  \ifstep{N1 OR N2}{content}         same as above ("OR" and "," are interchangeable)
%
%  Word aliases still accepted for single steps: eins=1, zwei=2, etc.
%  (Useful for a quick \showmytikz[eins]{...} shorthand.)
% ═══════════════════════════════════════════════════════════════════════════════

% ── Active step set: stored as ,1,2,3, (with surrounding commas for matching) ─
\def\@stepset{,,}%  default: empty set

% ── Word → number: resolves a single token to its digit string ────────────────
% Used only for single-word shorthands. Returns the digit in \@ts@num.
\newcommand{\@resolveword}[1]{%
  \IfStrEqCase{#1}{%
    {null}{\def\@ts@num{}}%
    {eins}{\def\@ts@num{1}}%
    {zwei}{\def\@ts@num{2}}%
    {drei}{\def\@ts@num{3}}%
    {vier}{\def\@ts@num{4}}%
    {fuenf}{\def\@ts@num{5}}%
    {sechs}{\def\@ts@num{6}}%
    {sieben}{\def\@ts@num{7}}%
    {acht}{\def\@ts@num{8}}%
    {neun}{\def\@ts@num{9}}%
    {zehn}{\def\@ts@num{10}}%
    {one}{\def\@ts@num{1}}%
    {two}{\def\@ts@num{2}}%
    {three}{\def\@ts@num{3}}%
    {four}{\def\@ts@num{4}}%
    {five}{\def\@ts@num{5}}%
    {six}{\def\@ts@num{6}}%
    {seven}{\def\@ts@num{7}}%
    {eight}{\def\@ts@num{8}}%
    {nine}{\def\@ts@num{9}}%
    {ten}{\def\@ts@num{10}}%
  }[\def\@ts@num{#1}]% fallback: already a number
}

% ── Build \@stepset from a comma-separated list (words or numbers) ────────────
\newcommand{\@buildstepset}[1]{%
  \gdef\@stepset{,}%
  \forcsvlist{\@addtostepset}{#1}%
}
\newcommand{\@addtostepset}[1]{%
  \def\@trimmed{#1}%
  \trim@spaces@in\@trimmed
  \@resolveword{\@trimmed}%
  \ifx\@ts@num\empty\else
    \expandafter\xdef\expandafter\@stepset\expandafter{\@stepset\@ts@num,}%
  \fi
}

% ═══════════════════════════════════════════════════════════════════════════════
%  \ifstep / \ifnotstep — now accept multiple steps combined with "," or "OR"
%
%  \ifstep{1}{foo}          — foo shown if step 1 is active
%  \ifstep{1,3}{foo}        — foo shown if step 1 OR step 3 is active
%  \ifstep{1 OR 3}{foo}     — same as above; "OR" and "," are interchangeable
%  \ifstep{1, 3 OR 5}{foo}  — mixing separators is fine too
% ═══════════════════════════════════════════════════════════════════════════════

\newif\if@hsb@stepor@found

% Catcode-safe membership test: sets \ifin@
\newcommand{\@hsb@ifinstepset}[1]{%
  \edef\@hsb@tmp{\noexpand\in@
    {,\detokenize{#1},}%
    {\detokenize\expandafter{\@stepset}}}%
  \@hsb@tmp
}
% Test one (trimmed) candidate against the active step set
\newcommand{\@hsb@stepor@test}[1]{%
  \def\@hsb@trimmed{#1}%
  \trim@spaces@in\@hsb@trimmed
  \expandafter\@hsb@ifinstepset\expandafter{\@hsb@trimmed}%
  \ifin@ \@hsb@stepor@foundtrue \fi
}

% Helper that takes the (already fully-expanded) list as a real argument,
% so forcsvlist actually sees the literal comma-separated text.
\newcommand{\@hsb@stepor@dolist}[1]{\forcsvlist{\@hsb@stepor@test}{#1}}

\newcommand{\@hsb@stepor@check}[1]{%
  \@hsb@stepor@foundfalse
  \def\@hsb@stepor@arg{#1}%
  % Normalize "OR" to "," so "1 OR 3", "1,3", and "1, 3 OR 5" all behave the same
  \StrSubstitute{\@hsb@stepor@arg}{OR}{,}[\@hsb@stepor@arg]%
  % Force-expand \@hsb@stepor@arg into literal text before forcsvlist sees it --
  % passing a macro *name* to forcsvlist does NOT auto-expand it, it would be
  % treated as a single opaque list item.
  \expandafter\@hsb@stepor@dolist\expandafter{\@hsb@stepor@arg}%
}

% ── \ifstep{N}{content} — show content if any listed N is in the active set ──
\newcommand{\ifstep}[2]{%
  \@hsb@stepor@check{#1}%
  \if@hsb@stepor@found #2\fi
}

% ── \ifnotstep{N}{content} — show content if NONE of the listed N are active ─
\newcommand{\ifnotstep}[2]{%
  \@hsb@stepor@check{#1}%
  \if@hsb@stepor@found\else #2\fi
}

% ── \ifsteponly{N}{suppress-if-any}{content} ─────────────────────────────────
% Like \ifstep{N}{content} but suppresses content if ANY of the steps listed
% in suppress-if-any are also active.
%
% Example: \ifsteponly{3}{5,6}{content}
%   Shows content if step 3 is active AND steps 5 and 6 are NOT active.
%
% Use this when a later step replaces rather than adds to an earlier step.
\newif\if@hsb@suppressed
\newcommand{\@hsb@checksuppress}[1]{%
  \def\@hsb@trimmed{#1}%
  \trim@spaces@in\@hsb@trimmed
  \expandafter\@hsb@ifinstepset\expandafter{\@hsb@trimmed}%
  \ifin@ \@hsb@suppressedtrue \fi
}
\newcommand{\ifsteponly}[3]{%
  \ifstep{#1}{%
    \@hsb@suppressedfalse
    \forcsvlist{\@hsb@checksuppress}{#2}%
    \if@hsb@suppressed\else #3\fi
  }{}%
}

% ── Keys for \showmytikz ──────────────────────────────────────────────────────
\define@key{showmytikz}{step}{\def\@ts@step{#1}}
\define@key{showmytikz}{caption}{\def\@ts@caption{#1}}
\define@key{showmytikz}{label}{\def\@ts@label{#1}}

% ── \showmytikz[1,2,3]{file.tex}  or  \showmytikz[step=drei]{file.tex} ────────
\newcommand{\showmytikz}[2][]{%
  \begingroup%
  \def\@ts@step{}%
  \def\@ts@caption{}%
  \def\@ts@label{}%
  % Save the current stepset so nested calls don't clobber it
  \let\@stepset@saved\@stepset%
  % Parse arguments and build new stepset
  \IfSubStr{#1}{=}{%
    \setkeys{showmytikz}{#1}%
    \@buildstepset{\@ts@step}%
  }{%
    \@buildstepset{#1}%
  }%
  \if@hsbbeamer
    \@hsb@tikz@beamer{#2}%
  \else%
    \@hsb@tikz@article{#2}%
  \fi
  % Restore the previous stepset (xdef made it global, so restore globally too)
  \global\let\@stepset\@stepset@saved
  \endgroup
}

% ── Beamer: fit into slide ────────────────────────────────────────────────────
% \begingroup scopes coordinate \def's; resetting \tikz@intersect@namedpaths
% clears the named-path registry so path names don't leak between diagrams.
\newcommand{\@hsb@tikz@beamer}[1]{%
  {\singlespacing
  \begin{adjustbox}{max width=200pt, max totalheight=0.8\textheight}%
    \IfFileExists{#1}{%
        \input{#1}%
        }{{\color{red}FILE NOT FOUND: #1}}%
  \end{adjustbox}%
  }%
}

% ── Beamer: more room for one figure (environments hsbfull, hsbfullslide) ─────
% Applies to \showmytikz, \showmytree and \showmybitmap.
% \showmytikz and \showmytree fit their picture into
%   max width=200pt, max totalheight=0.8\textheight       (see above).
% Inside hsbfull that limit is replaced, for the figures within the environment
% only (the original is restored at \end{hsbfull}). The optional argument is
% passed to adjustbox; the default is the whole text area of the frame:
%     \begin{hsbfull}
%       \showmytikz[1,2]{file.tex}
%     \end{hsbfull}
%     \begin{hsbfull}[max width=0.9\textwidth, max totalheight=0.7\textheight]
% NOTE: "max ..." only ever SHRINKS: a picture smaller than the limit keeps its
% natural size (a bitmap: pixels / dpi stored in the file). To scale UP use width:
%     \begin{hsbfull}[width=\textwidth, max totalheight=\textheight]
% (a low-resolution bitmap will look blurry when enlarged).
% The same limit is applied to \showmybitmap (its default is 200pt x 150pt, kept
% in \@hsb@bitmap@opts). The article build is not affected (its figures already
% scale to \linewidth).
\newcommand{\@hsb@bitmap@opts}{max size={200pt}{150pt}}
\newenvironment{hsbfull}[1][max width=\textwidth, max totalheight=\textheight]{%
  \renewcommand{\@hsb@bitmap@opts}{#1}%
  \renewcommand{\@hsb@tikz@beamer}[1]{{\singlespacing
    \begin{adjustbox}{#1}%
      \IfFileExists{##1}{\input{##1}}{{\color{red}FILE NOT FOUND: ##1}}%
    \end{adjustbox}}}%
}{}

% hsbfullslide: the figure over the WHOLE slide, edge to edge. Use it in a
% [plain] frame:  \begin{frame}[plain]{Title} ... \end{frame}.  Beamer: an
% absolutely positioned box the size of the page (needs the textpos package,
% like \mytext), content centred in it. Article: the normal figure. It takes the
% same optional argument as hsbfull; the default is the whole page:
%     \begin{hsbfullslide}[width=\paperwidth, max totalheight=\paperheight]
\newenvironment{hsbfullslide}[1][max width=\paperwidth, max totalheight=\paperheight]{%
  \if@hsbbeamer
    \begin{textblock*}{\paperwidth}(0pt,0pt)%
    \begin{minipage}[c][\paperheight][c]{\paperwidth}\centering
    \begin{hsbfull}[#1]%
  \else
    \begin{hsbfull}%
  \fi
}{%
  \if@hsbbeamer
    \end{hsbfull}\end{minipage}\end{textblock*}%
  \else
    \end{hsbfull}%
  \fi
}
% ── Automatic label keys ─────────────────────────────────────────────────────
%  Internal labels are built from running numbers (fig:hsbauto<n>,
%  tab:hsbauto<n>), NOT from the frame title: titles may contain commands
%  (\strut, \\, \textbf, ...) that break \ref/\label, and identical titles in
%  different chapters would produce duplicate labels.
%  For hand-made cross-references give a stable name with the label= key,
%  e.g. \showmytikz[step=1,label=fig:bremen-gdp]{...} -> \ref{fig:bremen-gdp}.
%  label= works with or without caption=.
\newcount\hsb@figid
\newcount\hsb@tabid
% \@hsb@userlabel: set the user's label (if any) next to the automatic one
\newcommand{\@hsb@userlabel}{%
  \ifdefined\@ts@label
    \ifdefempty{\@ts@label}{}{\label{\@ts@label}}%
  \fi
}

% ── Article: wrap in figure with auto caption/label ──────────────────────────
\newcommand{\@hsb@tikz@article}[1]{%
  \IfFileExists{#1}{%
    \let\myoldfighandle\myfighandle%
    \global\let\myfighandle\mysechandle%
    \ifthenelse{\equal{\myoldfighandle}{\myfighandle}}{%
      \stepcounter{mysubfigure}%
    }{%
      \setcounter{mysubfigure}{0}%
    }%
    \global\advance\hsb@figid\@ne%
    \edef\@hsb@figkey{fig:hsbauto\the\hsb@figid}%
    \ifhmode\unskip\fi\textbf{(Fig.~\ref{\@hsb@figkey})}%
    \begin{figure}[ht!]%
      \centering%
          \singlespacing
          \begin{adjustbox}{max width=\linewidth}%
            \IfFileExists{#1}{%
            \input{#1}%
            }{{\color{red}FILE NOT FOUND: #1}}%
          \end{adjustbox}%
            % \onehalfspacing
      \ifdefempty{\@ts@caption}{%
        \caption{\mysechandle~\themysubfigure}%
      }{%
        \caption{\@ts@caption}%
      }%
      \label{\@hsb@figkey}%
      \@hsb@userlabel
    \end{figure}%
  }{{\color{red}FILE NOT FOUND: #1}}%
}

% ── \showmybitmap[url]{file} ──────────────────────────────────────────────────
\newcommand{\showmybitmap}[2][]{%
  \IfFileExists{#2}{%
    \if@hsbbeamer
      \href{#1}{\expandafter\adjustimage\expandafter{\@hsb@bitmap@opts}{#2}}%
    \else
      \let\myoldfighandle\myfighandle
      \global\let\myfighandle\mysechandle
      \ifthenelse{\equal{\myoldfighandle}{\myfighandle}}{%
        \stepcounter{mysubfigure}%
      }{%
        \setcounter{mysubfigure}{0}%
      }%
      \global\advance\hsb@figid\@ne
      \edef\@hsb@figkey{fig:hsbauto\the\hsb@figid}%
      \ifhmode\unskip\fi\textbf{(Fig.~\ref{\@hsb@figkey})}%
      \begin{figure}[ht!]%
        \centering%
        \adjustimage{max size=\linewidth}{#2}%                                  % <- article: back to the original
        \caption{\mysechandle~\themysubfigure}\label{\@hsb@figkey}
      \end{figure}%
    \fi
  }{\color{red}FILE NOT FOUND: #2}%
}

% ── \mytable[steps]{content} ─────────────────────────────────────────────────
%  \mytable{...}                        as before (no step change)
%  \mytable[1]{\input{file.tex}}        show only step 1 of the content
%  \mytable[1,2]{\input{file.tex}}      show steps 1 and 2
%  \mytable[step=2,caption=Mexico,label=tab:mex]{\input{file.tex}}
%  Inside the content/file use \ifstep{N}{...} as in TikZ files.
\newcommand{\mytable}[2][]{%
  \begingroup
  \def\@ts@step{}%
  \def\@ts@caption{}%
  \def\@ts@label{}%
  \let\@stepset@saved\@stepset
  % Only touch the step set if an option was given -> old calls unchanged
  \ifx\relax#1\relax\else
    \IfSubStr{#1}{=}{%
      \setkeys{showmytikz}{#1}%
      \ifdefempty{\@ts@step}{}{\@buildstepset{\@ts@step}}%
    }{%
      \@buildstepset{#1}%
    }%
  \fi
  \if@hsbbeamer
    #2%
  \else
    \let\myoldtabhandle\mytabhandle
    \global\let\mytabhandle\mysechandle
    \ifthenelse{\equal{\myoldtabhandle}{\mytabhandle}}{%
      \stepcounter{mysubtab}%
    }{%
      \setcounter{mysubtab}{0}%
    }%
    \global\advance\hsb@tabid\@ne
    \edef\@hsb@tabkey{tab:hsbauto\the\hsb@tabid}%
     \ifhmode\unskip\fi\textbf{(Tab.~\ref{\@hsb@tabkey})}%
    \begin{table}[ht!]%
      \centering%
      \ifdefempty{\@ts@caption}{%
        \caption{\mysechandle~\themysubtab}%
      }{%
        \caption{\@ts@caption}%
      }%
      \label{\@hsb@tabkey}%
      \@hsb@userlabel
      #2%
    \end{table}%
  \fi
  \global\let\@stepset\@stepset@saved
  \endgroup
}

% ── \mysource{...}: source line below a comparison table ─────────────────────
%  Use inside \mytable after the table:
%    \mytable[4]{\input{tab-economicdata}\mysource{NBS China; ...}}
%  The box has the width of a {K} table and a FIXED height of two lines, so
%  tables shown step by step keep exactly the same size.
%  Keep \hsbTableWidth in sync with the column widths of {K}.
\newlength{\hsbTableWidth}
\setlength{\hsbTableWidth}{\dimexpr 2.6cm+3.4cm+3.0cm+1.0cm+8\tabcolsep+\arrayrulewidth\relax}
\newcommand{\mysource}[1]{%
  \par\smallskip
  {\scriptsize
   \parbox[t][2\baselineskip][t]{\hsbTableWidth}{\raggedright Sources: #1}}%
  \par
}

% ── Text helpers ──────────────────────────────────────────────────────────────
\newcommand{\mycomment}[2][]{%
  \if@hsbbeamer
    \begin{textblock*}{\hsbCommentWidth}(\hsbCommentX,\hsbCommentY)\tiny #2\end{textblock*}%
  \else
    #2%\par%
  \fi
}

\newcommand{\mytext}[2][]{%
  \if@hsbbeamer
    \begin{textblock*}{200pt}(20pt,50pt){\footnotesize #2\par}\end{textblock*}%
  \else
    #2\par%
  \fi
}

\newcommand{\mylonglist}[2][]{%
  \begin{multicols}{2}#2\end{multicols}%
}



% ── \myblock: small coloured progress/fill bar ───────────────────────────────
\newcommand{\myblock}[2][0.1ex]{%
  \begin{tikzpicture}[x=#1, y=1ex]
    \draw[fill=HSBgruen!50] (0,0) rectangle (#2,1);
  \end{tikzpicture}%
}

