\newcounter{pcell}
\newcommand{\payoff}[2]{%
    \stepcounter{pcell}%
    \edef\cname{\ifcase\value{pcell}%
        \or AA\or AB\or BA\or BB\fi}%
    \begin{tikzpicture}[baseline=(current bounding box.center),
                        remember picture]
        \node[draw, minimum width=5em, minimum height=5em, 
              inner sep=0pt] (box) {};
        \node[anchor=north east, text=blue, inner sep=0pt,
              name=\cname-al] at ([xshift=-7pt, yshift=-7pt]box.north east) {#1};
        \node[anchor=south west, text=red, inner sep=0pt,
              name=\cname-bo] at ([xshift=7pt, yshift=7pt]box.south west) {#2};
    \end{tikzpicture}%
}





